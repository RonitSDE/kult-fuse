{
  "name": "kult-fuse",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "description": "KULT Fuse: Solana agent mandates with DFlow signal, Velocity execution, Kalshi read-only market context and evidence-labeled decision journal.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/http/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/http/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "agent:demo": "node scripts/agent-policy-demo.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "markets": "node --env-file-if-exists=.env scripts/markets.mjs",
    "smoke:dflow": "node --env-file-if-exists=.env scripts/smoke-dflow.mjs",
    "smoke:polymarket": "node --env-file-if-exists=.env scripts/smoke-polymarket.mjs",
    "venue:setup": "node --env-file-if-exists=.env scripts/venue-setup.mjs",
    "proof:venue": "node --env-file-if-exists=.env scripts/venue-proof-run.mjs",
    "verify": "node --env-file-if-exists=.env scripts/verify.mjs",
    "release:check": "node --env-file-if-exists=.env scripts/release-check.mjs",
    "submission:check": "node --env-file-if-exists=.env scripts/submission-check.mjs",
    "manifest:source": "node scripts/source-manifest.mjs",
    "anchor:init": "node --env-file-if-exists=.env scripts/init-anchor.mjs",
    "anchor:local-test": "node --env-file-if-exists=.env scripts/anchor-local-test.mjs"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.1",
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@velocity-exchange/sdk": "0.27.0",
    "bn.js": "5.2.2"
  }
}
