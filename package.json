{
  "name": "kult-fuse",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "KULT Fuse PREDICT-first sponsor edition: real Solana pm-AMM swaps and liquidity, app-side risk mandates, verified-onchain scoreboards. Legacy perps lab remains isolated.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/http/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/http/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "agent:demo": "node scripts/agent-policy-demo.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "markets": "node --env-file-if-exists=.env scripts/markets.mjs",
    "smoke:dflow": "node --env-file-if-exists=.env scripts/smoke-dflow.mjs",
    "smoke:polymarket": "node --env-file-if-exists=.env scripts/smoke-polymarket.mjs",
    "venue:setup": "node --env-file-if-exists=.env scripts/venue-setup.mjs",
    "proof:venue": "node --env-file-if-exists=.env scripts/venue-proof-run.mjs",
    "verify": "node --env-file-if-exists=.env scripts/verify.mjs",
    "release:check": "node --env-file-if-exists=.env scripts/release-check.mjs",
    "submission:check": "node --env-file-if-exists=.env scripts/submission-check.mjs",
    "manifest:source": "node scripts/source-manifest.mjs",
    "anchor:init": "node --env-file-if-exists=.env scripts/init-anchor.mjs",
    "anchor:local-test": "node --env-file-if-exists=.env scripts/anchor-local-test.mjs",
    "predict:install": "npm --prefix apps/predict ci --no-audit --no-fund",
    "predict:dev": "npm --prefix apps/predict run dev",
    "predict:build": "node --env-file-if-exists=.env apps/predict/node_modules/vite/bin/vite.js build apps/predict",
    "predict:check": "npm --prefix apps/predict run check",
    "predict:market:create": "node --env-file-if-exists=.env apps/predict/scripts/create-market.cjs",
    "predict:market:resolve": "node --env-file-if-exists=.env apps/predict/scripts/resolve-market.cjs",
    "predict:vault:create": "node --env-file-if-exists=.env apps/predict/scripts/create-vault.cjs",
    "predict:vault:launch": "node --env-file-if-exists=.env apps/predict/scripts/launch-vault.cjs",
    "predict:preflight": "node --env-file-if-exists=.env scripts/predict-preflight.mjs",
    "predict:submission": "node --env-file-if-exists=.env scripts/predict-submission-check.mjs"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.1",
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@velocity-exchange/sdk": "0.27.0",
    "bn.js": "5.2.2"
  }
}
