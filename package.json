{
  "name": "kult-fuse",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "KULT Fuse \u2014 a Solana execution mandate: live prediction-market probability drives a perp position within an onchain-enforced policy",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/http/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/http/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node --env-file-if-exists=.env scripts/verify.mjs",
    "smoke:dflow": "node --env-file-if-exists=.env scripts/smoke-dflow.mjs",
    "smoke:flash": "node --env-file-if-exists=.env scripts/smoke-flash.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "release:check": "node --env-file-if-exists=.env scripts/release-check.mjs",
    "anchor:init": "node --env-file-if-exists=.env scripts/init-anchor.mjs",
    "anchor:local-test": "node --env-file-if-exists=.env scripts/anchor-local-test.mjs",
    "smoke:polymarket": "node --env-file-if-exists=.env scripts/smoke-polymarket.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@coral-xyz/borsh": "0.31.1",
    "@pythnetwork/price-service-client": "1.10.0",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "camelcase": "6.3.0",
    "flash-sdk": "15.17.2"
  },
  "overrides": {
    "@pythnetwork/price-service-client": "1.10.0"
  },
  "resolutions": {
    "@pythnetwork/price-service-client": "1.10.0"
  }
}
