# ── Runtime ────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
KULT_FUSE_MODE=demo
DATA_DIR=./.data
FUSE_ADMIN_TOKEN=CHANGE_ME_IN_LIVE_MODE
PUBLIC_DEMO_URL=
BUILD_TAG=submission-2026-10-09
BUILD_SHA=DEV_UNSET

# ── Solana / OrbitFlare ──────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://rpc.orbitflare.com?api_key=YOUR_API_KEY
SOLANA_WS_URL=
SOLANA_COMMITMENT=confirmed
SOLSCAN_BASE_URL=https://solscan.io

# ── DFlow prediction market ──────────────────────────────────────────────
DFLOW_API_KEY=
DFLOW_BASE_URL=https://prediction-markets-api.dflow.net
DFLOW_DEV_BASE_URL=https://dev-prediction-markets-api.dflow.net
DFLOW_MARKET_MINT=
DFLOW_POLL_MS=3000
DFLOW_MAX_SPREAD_BPS=1200
DFLOW_MAX_AGE_SEC=20

# ── Perp execution: paper | flash | driver ───────────────────────────────
PERP_ADAPTER=paper
PERP_SYMBOL=SOL-PERP
PERP_MAX_SLIPPAGE_BPS=50

# Flash Trade live/devnet adapter (never commit the key)
FLASH_CLUSTER=devnet
FLASH_POOL=devnet.1
FLASH_PRIVATE_KEY_JSON=
FLASH_TARGET_SYMBOL=SOL
FLASH_COLLATERAL_SYMBOL=USDC
FLASH_LEVERAGE_X=1
FLASH_MIN_ORDER_USD=5
FLASH_FILL_TIMEOUT_MS=15000
FLASH_PRIORITIZATION_FEE=0

# Generic external driver fallback
PERP_DRIVER_URL=
PERP_DRIVER_TOKEN=

# ── Solana Fuse program ──────────────────────────────────────────────────
FUSE_ONCHAIN=0
FUSE_PROGRAM_ID=
# Optional: the app creates its own onchain fuse account on first boot and after each reset.
FUSE_PDA=
FUSE_IDL_PATH=./contracts/fuse-anchor/target/idl/kult_fuse.json
FUSE_OWNER_PRIVATE_KEY_JSON=
FUSE_EXECUTION_PRIVATE_KEY_JSON=
FUSE_ORACLE_PRIVATE_KEY_JSON=
# Minimum seconds between onchain fuse creations (limits Reset spam draining the owner key).
FUSE_RESET_COOLDOWN_SEC=10
AUTO_WORKER=0
AUTO_WORKER_MS=3000

# ── Public proof metadata (populate after devnet smoke) ──────────────────
PROOF_CREATE_TX=
PROOF_ARM_TX=
PROOF_KILL_TX=
PROOF_FLASH_OPEN_TX=
PROOF_FLASH_RESIZE_TX=
PROOF_FLASH_CLOSE_TX=
