# ── Runtime ────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
DATA_DIR=./.data
# Operator token for every state-changing action (arm, kill, settle, new mandate). 24+ random chars.
FUSE_ADMIN_TOKEN=CHANGE_ME
PUBLIC_URL=
BUILD_TAG=submission-2026-10-09
BUILD_SHA=DEV_UNSET
# The live policy (curve, cap, kill threshold). Its market and expiry are bound at runtime.
POLICY_FILE=./policy.example.json

# ── Solana ───────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=
SOLANA_COMMITMENT=confirmed
SOLSCAN_BASE_URL=https://solscan.io

# ── Event data: polymarket | dflow ───────────────────────────────────────
EVENT_SOURCE=polymarket
# Slug lives in src/adapters/event/polymarket-event.mjs (DEFAULT_POLYMARKET_MARKET).
POLYMARKET_OUTCOME=Yes
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# DFlow (only when EVENT_SOURCE=dflow)
DFLOW_API_KEY=
DFLOW_BASE_URL=https://prediction-markets-api.dflow.net
DFLOW_MARKET_MINT=

# ── Perp execution: flash | driver ───────────────────────────────────────
PERP_ADAPTER=flash
PERP_SYMBOL=SOL-PERP
PERP_MAX_SLIPPAGE_BPS=50

# Flash Trade devnet (never commit the key). Fund it with SOL and Flash devnet USDC.
FLASH_CLUSTER=devnet
FLASH_POOL=devnet.1
FLASH_PRIVATE_KEY_JSON=
FLASH_TARGET_SYMBOL=SOL
FLASH_COLLATERAL_SYMBOL=USDC
FLASH_LEVERAGE_X=1
FLASH_MIN_ORDER_USD=5
FLASH_FILL_TIMEOUT_MS=15000
FLASH_PRIORITIZATION_FEE=0

# Generic external driver (only when PERP_ADAPTER=driver)
PERP_DRIVER_URL=
PERP_DRIVER_TOKEN=

# ── Solana Fuse program ──────────────────────────────────────────────────
FUSE_PROGRAM_ID=
FUSE_IDL_PATH=./contracts/fuse-anchor/target/idl/kult_fuse.json
FUSE_OWNER_PRIVATE_KEY_JSON=
FUSE_EXECUTION_PRIVATE_KEY_JSON=
FUSE_ORACLE_PRIVATE_KEY_JSON=
# Minimum seconds between onchain fuse creations.
FUSE_RESET_COOLDOWN_SEC=10
# Live worker: polls the market and reconciles the position (0 only for maintenance).
AUTO_WORKER=1
AUTO_WORKER_MS=3000

# ── Pinned proof links (optional; live links come from the running fuse) ─
PROOF_CREATE_TX=
PROOF_ARM_TX=
PROOF_KILL_TX=
PROOF_FLASH_OPEN_TX=
PROOF_FLASH_RESIZE_TX=
PROOF_FLASH_CLOSE_TX=
