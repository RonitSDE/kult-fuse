# ── Runtime ────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
DATA_DIR=./.data
# Operator token for every state-changing action (arm, kill, settle, new mandate). 24+ random chars.
FUSE_ADMIN_TOKEN=CHANGE_ME
PUBLIC_URL=
BUILD_TAG=fuse-v1.10.0
BUILD_SHA=DEV_UNSET
# The live policy (curve, cap, kill threshold). Its market and expiry are bound at runtime.
POLICY_FILE=./policy.example.json

# ── Solana ───────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=
SOLANA_COMMITMENT=confirmed
SOLSCAN_BASE_URL=https://solscan.io

# ── Signal: Kalshi markets on Solana through DFlow ────────────────────────
EVENT_SOURCE=dflow
# The YES mint of the market. `npm run markets` lists candidates (with --series / --search).
DFLOW_MARKET_MINT=
# Empty key = DFlow's public dev host. Set a key to use the production host.
DFLOW_API_KEY=
DFLOW_BASE_URL=
# Orderbook sizes are contracts ($1 at settlement). Set 6 if your host reports raw token units.
DFLOW_SIZE_DECIMALS=0
# The feed counts as live only if its book sequence advanced within this window (seconds).
# Pick an active market; a quiet book past this window blocks risk increases.
DFLOW_MAX_BOOK_IDLE_SEC=900

# ── Perp execution: Velocity (Drift v2's successor) ──────────────────────
PERP_ADAPTER=velocity
PERP_SYMBOL=SOL-PERP
PERP_MAX_SLIPPAGE_BPS=50
# VELOCITY_ENV=mainnet-beta places real orders with real USDT. Keep devnet for the demo.
VELOCITY_ENV=devnet
VELOCITY_RPC_URL=
# A dedicated wallet. Fund it once: npm run venue:setup -- --fund 25
VELOCITY_PRIVATE_KEY_JSON=
VELOCITY_MARKET_INDEX=0
VELOCITY_SUBACCOUNT_ID=0
VELOCITY_MIN_ORDER_USD=1
VELOCITY_MAX_SLIPPAGE_BPS=50
VELOCITY_FILL_TIMEOUT_MS=20000
# Devnet dUSDT faucet program. Empty = the address in the SDK's bundled token_faucet IDL.
VELOCITY_FAUCET_PROGRAM_ID=

# ── Solana Fuse program ──────────────────────────────────────────────────
FUSE_PROGRAM_ID=
FUSE_IDL_PATH=./deploy/idl/kult_fuse.json
FUSE_OWNER_PRIVATE_KEY_JSON=
FUSE_EXECUTION_PRIVATE_KEY_JSON=
FUSE_ORACLE_PRIVATE_KEY_JSON=
# Minimum seconds between onchain fuse creations.
FUSE_RESET_COOLDOWN_SEC=10
# Live worker: polls the market and reconciles the position (0 only for maintenance).
AUTO_WORKER=0
AUTO_WORKER_MS=3000
# Setup mode retries the live start this often (0 = never).
SETUP_RETRY_SEC=120

# Explorer proof is derived from this mandate's live transactions and receipts.

# Mainnet venue orders are disabled by default in this hackathon build.
# FUSE_ALLOW_MAINNET_ORDERS=I_ACKNOWLEDGE_REAL_FUNDS

# Read-only Kalshi PUBLIC reference panel (no auth, no orders, never an oracle for Fuse).
# Setting to 0 hides remote Kalshi lookups; DFlow remains the trading signal.
KALSHI_OBSERVER_ENABLED=1
# production or demo. These are separate venues, not Velocity order environments.
KALSHI_OBSERVER_ENV=production

# PREDICT Sponsor-First Devnet Arena (independent of Velocity/legacy Fuse setup)
PREDICT_DEVNET_RPC=https://api.devnet.solana.com
# Must be a persistent single-instance disk or database; prevents duplicate receipt counting.
PREDICT_RECEIPTS_FILE=./.data/predict-receipts.json
# Generate with: openssl rand -hex 32
# Required: 64 hex characters (openssl rand -hex 32). Without it trades cannot be attested.
PREDICT_ATTESTATION_KEY=
# How often the server finalizes swaps reported before finality (ms).
PREDICT_RECONCILE_MS=10000
# Optional public lifecycle proof produced by npm run predict:submission.
PREDICT_LIFECYCLE_FILE=./.data/predict-proofs.json
PREDICT_LIFECYCLE_INPUT=
PREDICT_VIDEO_URL=
# Use a browser-distributable URL. Keep private RPC credentials in PREDICT_DEVNET_RPC only.
VITE_DEVNET_RPC=https://api.devnet.solana.com
VITE_FEATURED_VAULTS=
VITE_FEATURED_MARKETS=
PREDICT_VAULT_QUESTION=
PREDICT_VAULT_COMMIT_SEC=600
PREDICT_VAULT_TARGET_MUSDC=10
PREDICT_VAULT_PDA=
# The PREDICT app runs from apps/predict/dist after build; no signer key is held by server.
# VITE_DEVNET_RPC is read at build time; should use a reliable Solana devnet endpoint.
# In apps/predict/.env.local: VITE_FEATURED_MARKETS=<real_PREDICT_market_PDA_1>,<PDA_2>
# Builder-only CLI settings: NEVER COMMIT A WALLET KEY. For create and resolve only.
PREDICT_BUILDER_KEYPAIR_PATH=
PREDICT_MARKET_QUESTION=
PREDICT_MARKET_DURATION_SEC=3600
PREDICT_MARKET_LIQUIDITY_MUSDC=50
PREDICT_MARKET_SEED_BPS=5000
PREDICT_RESOLVE_MARKET=
PREDICT_RESOLVE_SIDE=
PREDICT_RESOLUTION_EVIDENCE_URL=
